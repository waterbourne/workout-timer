const CACHE_NAME = 'ab-workout-v7';
const urlsToCache = [
  '/',
  '/index.html',
  '/app.js',
  '/workouts.js', 
  '/exercises.js',
  '/detailed-exercises.js',
  '/real-exercises.js',
  '/manifest.json'
];

self.addEventListener('install', (event) => {
  event.waitUntil(
    caches.open(CACHE_NAME)
      .then((cache) => cache.addAll(urlsToCache))
  );
});

self.addEventListener('fetch', (event) => {
  event.respondWith(
    caches.match(event.request)
      .then((response) => {
        if (response) {
          return response;
        }
        return fetch(event.request);
      }
    )
  );
});